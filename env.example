# RocketRide connection. Leave the local URI when running the standalone MVP.
ROCKETRIDE_URI=ws://localhost:5565

# Optional RocketRide Cloud/on-prem authentication. Never commit a real token.
ROCKETRIDE_AUTH=

# Required by the native extract_data and query pipelines.
ROCKETRIDE_OPENAI_KEY=

# The native pipelines expect a local Qdrant service.
# Qdrant's default HTTP port is 6333.
ROCKETRIDE_QDRANT_HOST=localhost
ROCKETRIDE_QDRANT_PORT=6333
