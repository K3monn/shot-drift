{
  "components": [
    {
      "id": "dropper_shot",
      "provider": "dropper",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "dropper"
      },
      "ui": { "position": { "x": 20, "y": 220 } }
    },
    {
      "id": "parse_shot",
      "provider": "parse",
      "config": {},
      "input": [{ "lane": "tags", "from": "dropper_shot" }],
      "ui": { "position": { "x": 240, "y": 220 } }
    },
    {
      "id": "extract_shot",
      "provider": "extract_data",
      "config": {
        "profile": "default",
        "default": {
          "fields": [
            { "column": "shot_id", "type": "text" },
            { "column": "bean", "type": "text" },
            { "column": "roaster", "type": "text" },
            { "column": "roast_level", "type": "text" },
            { "column": "origin_country", "type": "text" },
            { "column": "roast_date", "type": "date" },
            { "column": "brew_date", "type": "date" },
            { "column": "days_off_roast", "type": "int" },
            { "column": "grind_setting", "type": "decimal" },
            { "column": "dose_g", "type": "decimal" },
            { "column": "yield_g", "type": "decimal" },
            { "column": "ratio", "type": "decimal" },
            { "column": "time_s", "type": "int" },
            { "column": "temp_c", "type": "int" },
            { "column": "tasting_notes", "type": "text" },
            { "column": "rating", "type": "int" }
          ]
        }
      },
      "input": [{ "lane": "text", "from": "parse_shot" }],
      "control": [{ "classType": "llm", "from": "llm_extractor" }],
      "ui": { "position": { "x": 460, "y": 220 } }
    },
    {
      "id": "embedding_shot",
      "provider": "embedding_transformer",
      "config": { "profile": "miniLM" },
      "input": [{ "lane": "documents", "from": "extract_shot" }],
      "ui": { "position": { "x": 900, "y": 220 } }
    },
    {
      "id": "qdrant_shots",
      "provider": "qdrant",
      "config": {
        "profile": "local",
        "local": {
          "host": "localhost",
          "port": 6333,
          "score": 0.7,
          "collection": "grind_state_shots",
          "serverName": "qdrant"
        }
      },
      "input": [{ "lane": "documents", "from": "embedding_shot" }],
      "ui": { "position": { "x": 1140, "y": 220 } }
    },
    {
      "id": "response_shot",
      "provider": "response_documents",
      "config": { "laneName": "documents" },
      "input": [{ "lane": "documents", "from": "extract_shot" }],
      "ui": { "position": { "x": 1140, "y": 360 } }
    },
    {
      "id": "llm_extractor",
      "provider": "llm_openai",
      "config": {
        "profile": "openai-5",
        "openai-5": { "apikey": "${ROCKETRIDE_OPENAI_KEY}" }
      },
      "ui": { "position": { "x": 460, "y": 440 } }
    }
  ],
  "project_id": "b5e5b157-3ee1-4dd8-8ea1-8b6f4d4bf7ae",
  "viewport": { "x": 0, "y": 0, "zoom": 1 },
  "version": 1
}
