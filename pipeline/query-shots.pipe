{
  "components": [
    {
      "id": "chat_shots",
      "provider": "chat",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "chat"
      },
      "ui": { "position": { "x": 20, "y": 220 } }
    },
    {
      "id": "embedding_query",
      "provider": "embedding_transformer",
      "config": { "profile": "miniLM" },
      "input": [{ "lane": "questions", "from": "chat_shots" }],
      "ui": { "position": { "x": 240, "y": 220 } }
    },
    {
      "id": "qdrant_query",
      "provider": "qdrant",
      "config": {
        "profile": "local",
        "local": {
          "host": "localhost",
          "port": 6333,
          "score": 0.7,
          "collection": "grind_state_shots",
          "serverName": "qdrant"
        }
      },
      "input": [{ "lane": "questions", "from": "embedding_query" }],
      "ui": { "position": { "x": 460, "y": 220 } }
    },
    {
      "id": "llm_reasoner",
      "provider": "llm_openai",
      "config": {
        "profile": "openai-5",
        "openai-5": { "apikey": "${ROCKETRIDE_OPENAI_KEY}" }
      },
      "input": [{ "lane": "questions", "from": "qdrant_query" }],
      "ui": { "position": { "x": 700, "y": 220 } }
    },
    {
      "id": "response_shots",
      "provider": "response_answers",
      "config": { "laneName": "answers" },
      "input": [{ "lane": "answers", "from": "llm_reasoner" }],
      "ui": { "position": { "x": 940, "y": 220 } }
    }
  ],
  "project_id": "c4d43c7c-14b6-49a5-86f4-5e42a0bd4a23",
  "viewport": { "x": 0, "y": 0, "zoom": 1 },
  "version": 1
}
